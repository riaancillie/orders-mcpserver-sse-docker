{
  "name": "food-orders-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-file MCP server exposing mock food-delivery orders over Express + Streamable HTTP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "start:ts": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector",
    "docker:build": "docker build -t food-orders-mcp .",
    "docker:run": "docker run --rm -p 3010:3000 food-orders-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
